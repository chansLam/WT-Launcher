<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme" parent="@style/BaseWallpaperTheme">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="SplashTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Theme.WallpaperCropper" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:actionBarStyle">@style/WallpaperCropperActionBar</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
