<?xml version="1.0" encoding="utf-8"?>
<com.android.launcherWT.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.launcherWT.CustomFrameLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ViewStub
            android:layout_gravity="top|right"
            android:id="@+id/topRightStub"
            android:layout="@layout/status_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.launcherWT.WheelView
                android:id="@+id/image_scroll_picker"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.android.launcherWT.DragLayer
                    android:id="@+id/drag_layer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="0dp">
                    <com.android.launcherWT.Workspace
                        android:id="@+id/workspace"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        launcher:pageIndicator="@+id/page_indicator"
                        launcher:defaultScreen="@integer/config_workspaceDefaultScreen"/>
                    <include
                        android:layout_gravity="right"
                        android:id="@+id/hotseat"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        layout="@layout/hotseat"/>
                    <include
                        android:id="@+id/search_drop_target_bar"
                        android:visibility="gone"
                        layout="@layout/search_drop_target_bar"/>
                    <include
                        android:id="@+id/overview_panel"
                        android:visibility="gone"
                        layout="@layout/overview_panel"/>
                    <include
                        android:id="@+id/page_indicator"
                        layout="@layout/page_indicator"/>
                    <include
                        android:id="@+id/app_list_close"
                        layout="@layout/app_list_close"/>
                    <include
                        android:id="@+id/widgets_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        layout="@layout/widgets_view"/>
                    <include
                        android:id="@+id/apps_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        layout="@layout/all_apps"/>
                </com.android.launcherWT.DragLayer>
                <ViewStub
                    android:id="@+id/launcher_overlay_stub"
                    android:layout="@layout/launcher_overlay"
                    android:inflatedId="@+id/launcher_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
    </com.android.launcherWT.CustomFrameLayout>
</com.android.launcherWT.LauncherRootView>
