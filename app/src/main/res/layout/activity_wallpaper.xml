<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0121418"
    android:orientation="horizontal"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_wallpaper"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <RadioGroup
                android:id="@+id/wallpaper_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/mode_default"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wallpaper_default"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/mode_custom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wallpaper_custom"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/mode_daily"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wallpaper_daily_name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/daily_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpaper_source"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/daily_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/source_bing_zh"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_bing_zh"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/source_bing_en"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_bing_en"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/source_wallhaven"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_wallhaven"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/source_zzzmh"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_zzzmh"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/source_peapix"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_peapix"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                    <RadioButton
                        android:id="@+id/source_todaybing"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_todaybing"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                    <RadioButton
                        android:id="@+id/source_upx8"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_upx8"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                    <RadioButton
                        android:id="@+id/source_yumus"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/wallpaper_source_yumus"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />                </RadioGroup>

                <TextView
                    android:id="@+id/daily_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/custom_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/pick_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpaper_local" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/search_query"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/wallpaper_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#80FFFFFF" />

                    <Button
                        android:id="@+id/search_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallpaper_search" />
                </LinearLayout>

                <TextView
                    android:id="@+id/search_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/search_results"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

        <Button
            android:id="@+id/wallpaper_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wallpaper_confirm"
            android:textSize="18sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wallpaper_preview"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="24dp"
        android:layout_weight="1"
        android:background="#22FFFFFF"
        android:scaleType="centerCrop" />
</LinearLayout>
