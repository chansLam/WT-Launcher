<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingRight="@dimen/jg_top_right_view_right_margin"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/jg_top_right_view_height"
    android:layout_marginTop="@dimen/jg_top_right_view_top_margin">
    <com.autopai.support.utils.AirConditionView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/toprightview_aircondition"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:layout_marginRight="@dimen/jg_top_left_icon_margin"
        android:contentDescription="@null"/>
    <com.autopai.support.utils.UsbView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/toprightview_usb"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:layout_marginRight="@dimen/jg_top_left_icon_margin"
        android:src="@drawable/sw_ic_usb"
        android:contentDescription="@null"/>
    <com.autopai.support.utils.DvrView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/toprightview_dvr"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:layout_marginRight="@dimen/jg_top_left_icon_margin"
        android:src="@drawable/jg_dvr_status_record"
        android:contentDescription="@null"/>
    <com.autopai.support.utils.WifiView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/toprightview_wifi"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:layout_marginRight="@dimen/jg_top_left_icon_margin"/>
    <com.autopai.support.utils.BluetoothView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/toprightview_bluetooth"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:layout_marginRight="@dimen/jg_top_left_icon_margin"/>
    <com.autopai.support.utils.MuteView
        android:gravity="center_vertical"
        android:id="@+id/toprightview_horn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:layout_marginRight="@dimen/jg_top_left_icon_margin"
        android:src="@drawable/jp_horn_mute"
        android:contentDescription="@null"/>
    <ViewStub
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/iv_container"
        android:layout="@layout/jg_toplinearlayout_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"/>
    <com.autopai.support.utils.SignalView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_signal"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:src="@drawable/jg_ic_no_signal"/>
    <com.autopai.support.utils.Clock
        android:textSize="@dimen/jg_top_right_view_text_size"
        android:textColor="@color/toprightview_clock_text_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/toprightview_clock"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/jg_top_left_icon_margin"/>
</LinearLayout>
