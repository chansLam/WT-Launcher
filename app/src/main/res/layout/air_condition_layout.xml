<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_parent"
    android:background="@drawable/air_condition_background"
    android:paddingLeft="@dimen/top_right_view_air_condition_left_margin"
    android:paddingRight="@dimen/top_right_view_air_condition_right_margin"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/top_right_view_air_condition_bg_height">
    <com.autopai.support.view.TopImageView
        android:gravity="center"
        android:id="@+id/iv_aircondition_icon"
        android:layout_width="@dimen/top_right_view_air_condition_icon_size"
        android:layout_height="@dimen/top_right_view_air_condition_icon_size"
        android:layout_marginRight="@dimen/jg_top_right_view_air_condition_text_left_margin"
        android:src="@drawable/jg_ic_aircondition"
        android:layout_centerVertical="true"/>
    <com.autopai.support.view.TopTextView
        android:textSize="@dimen/jg_top_right_view_air_fun_text_size"
        android:textColor="@color/toprightview_temp_text_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_fun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.autopai.support.view.TopImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/jg_top_right_view_air_condition_text_divider_margin"
        android:layout_marginRight="@dimen/jg_top_right_view_air_condition_text_divider_margin"
        android:src="@drawable/jg_aircondition_line"/>
    <com.autopai.support.view.TopImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_air_level_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/top_right_view_air_electric_level_icon_left_margin"
        android:layout_marginRight="@dimen/top_right_view_air_electric_level_icon_right_margin"
        android:src="@drawable/jg_ic_aircondition_level"/>
    <com.autopai.support.view.TopTextView
        android:textSize="@dimen/jg_top_right_view_air_fun_text_size"
        android:textColor="@color/toprightview_clock_text_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.autopai.support.view.TopImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_purifer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/top_right_view_purifer_left_margin"
        android:layout_marginRight="@dimen/top_right_view_purifer_right_margin"
        android:src="@drawable/air_condition_purifer"/>
    <com.autopai.support.view.TopTextView
        android:textSize="@dimen/jg_top_right_view_air_fun_text_size"
        android:textColor="@color/toprightview_clock_text_color"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_off"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/air_off"/>
</LinearLayout>
