<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autopai.support.view.TopImageView
        android:id="@+id/bluetooth_img"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/jg_top_right_view_icon_height"
        android:src="@drawable/jg_ic_bt_noconn"
        android:layout_centerVertical="true"/>
    <com.autopai.support.view.TopImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/battery_img"
        android:paddingLeft="@dimen/jg_top_left_icon_margin"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.autopai.support.view.TopImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/signal_img"
        android:paddingLeft="@dimen/jg_top_left_icon_margin"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
